---
import { BUSINESS } from '../lib/site';
import { withBase } from '../lib/urls';

const services = [
  { href: '/services/concrete/', label: 'Custom & Stamped Concrete' },
  { href: '/services/masonry/', label: 'Block, Brick & Stone' },
  { href: '/services/outdoor/', label: 'Outdoor Kitchens & Fireplaces' },
];
const year = new Date().getFullYear();
---

{/*
  No top margin. Every page ends with either the black CTA band or a padded
  section, and a 96px band of cream ground sandwiched between two black blocks
  read as a rendering fault rather than as spacing. The red top border is the
  separator; the CTA's py-16 and the footer's py-14 supply the breathing room.
*/}
<footer class="border-t-4 border-cpf-red bg-cpf-black text-white/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      {/* alt="" is deliberate — decorative. The business name, license and
          address all appear as text in this footer already. */}
      <img src={withBase('/logo-mark.svg')} alt="" width="120" height="80" class="h-14 w-auto" loading="lazy" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Foundations, stamped concrete, natural stone, block walls and brick
        across the Conejo Valley.
      </p>
      <p class="mt-4 font-display text-sm uppercase tracking-[0.16em] text-cpf-chrome">
        Est. {BUSINESS.founded}<br />
        {BUSINESS.licenseLabel}
      </p>
    </div>

    <div>
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-white">Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.map((s) => (
          <li><a href={withBase(s.href)} class="hover:text-white hover:underline">{s.label}</a></li>
        ))}
        <li><a href={withBase('/projects/')} class="hover:text-white hover:underline">Featured Projects</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-display text-lg font-semibold uppercase tracking-wide text-white">Get in touch</h2>
      <p class="mt-4">
        <a href={BUSINESS.phoneHref} class="font-display text-2xl font-semibold text-white hover:text-cpf-yellow">
          {BUSINESS.phone}
        </a>
      </p>
      {
        BUSINESS.email ? (
          <p class="mt-2 text-sm"><a href={`mailto:${BUSINESS.email}`} class="hover:text-white hover:underline">{BUSINESS.email}</a></p>
        ) : (
          /* TODO_EMAIL — only a fragment ending "11@GMAIL.COM" survived Google's
             index. Rendering nothing is correct until the owner confirms it;
             a guessed address on a contractor's site is worse than no address. */
          <p class="mt-2 text-sm text-white/60">Phone is the fastest way to reach us.</p>
        )
      }
      <address class="mt-4 text-sm not-italic leading-relaxed">
        {BUSINESS.address.street}<br />
        {BUSINESS.address.locality}, {BUSINESS.address.region} {BUSINESS.address.postal}
      </address>
      <p class="mt-4 text-sm">
        Serving {BUSINESS.serviceArea.slice(0, 5).join(', ')} and the wider Conejo Valley.
      </p>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>&copy; {year} {BUSINESS.name}. {BUSINESS.licenseLabel}.</p>
      <p>Serving the Conejo Valley since {BUSINESS.founded} &middot; Fully insured &middot; Guaranteed completion dates</p>
    </div>
  </div>
</footer>
