---
import { BUSINESS, NAV } from '../lib/site';
import { withBase } from '../lib/urls';

const path = Astro.url.pathname;
const isActive = (href: string) => path === withBase(href) || path.startsWith(withBase(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-ground/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href={withBase('/')} class="flex shrink-0 items-center gap-3" aria-label={`${BUSINESS.name} — home`}>
      <img
        src={withBase('/logo-mark.svg')}
        alt=""
        width="72"
        height="48"
        class="h-10 w-auto sm:h-12"
        loading="eager"
      />
      <span class="hidden leading-none sm:block">
        <span class="block font-display text-lg font-semibold uppercase tracking-wide text-ink">
          CPF Custom Concrete
        </span>
        <span class="block font-display text-sm uppercase tracking-[0.18em] text-muted">
          &amp; Masonry
        </span>
      </span>
    </a>

    <nav class="ml-auto hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-7">
        {
          NAV.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="font-display text-base font-medium uppercase tracking-wider text-ink-soft transition-colors hover:text-cpf-red"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={BUSINESS.phoneHref}
      class="ml-auto inline-flex items-center gap-2 bg-cpf-red px-4 py-2.5 font-display text-base font-semibold uppercase tracking-wide text-white transition-colors hover:bg-cpf-red-dark md:ml-0"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"/>
      </svg>
      <span class="hidden sm:inline">{BUSINESS.phone}</span>
      <span class="sm:hidden">Call</span>
    </a>
  </div>

  <!-- Mobile nav: a plain scrollable row. No JS, no hamburger to mis-tap. -->
  <nav class="border-t border-line md:hidden" aria-label="Main, mobile">
    <ul class="flex overflow-x-auto px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        NAV.map((item) => (
          <li class="shrink-0">
            <a
              href={withBase(item.href)}
              class="block px-3 py-2.5 font-display text-sm font-medium uppercase tracking-wider text-ink-soft"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
