---
/**
 * The homepage hero.
 *
 * Extracted from index.astro so the review build can render two candidate
 * photographs through *identical* markup. An A/B where the two sides are
 * hand-copied is worth very little — any drift in scrim, height or type
 * becomes indistinguishable from a difference in the photograph, which is the
 * one thing the comparison exists to isolate.
 *
 * `asset` is the only knob. Everything else is fixed on purpose.
 */
import Img from './Img.astro';
import type { Asset } from '../lib/assets';
import { BUSINESS } from '../lib/site';
import { withBase } from '../lib/urls';

interface Props {
  asset: Asset;
  /**
   * Slot label for the image policy error, so a failure names which hero
   * tripped it rather than just "homepage hero".
   */
  label?: string;
  /** The review build renders more than one; only the real page is eager. */
  eager?: boolean;
}

const { asset, label = 'homepage hero', eager = true } = Astro.props;
---

<section class="relative isolate">
  <Img
    asset={asset}
    displayW={1900}
    sizes="100vw"
    label={label}
    eager={eager}
    class="absolute inset-0 h-full w-full"
    imgClass="h-full w-full object-cover object-center"
  />
  <!-- Scrim from the bottom so the headline holds contrast over a bright,
       high-key photograph without washing the stonework out. -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/15"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex min-h-[78svh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 md:min-h-[82svh]">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-cpf-yellow">
      Newbury Park &middot; Thousand Oaks &middot; Conejo Valley
    </p>
    <h1 class="mt-3 max-w-3xl text-[var(--text-hero)] font-bold uppercase text-white">
      Concrete and masonry that gets finished
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/90">
      Foundations, stamped concrete, natural stone, block walls and brick.
      <strong class="font-semibold text-white">Family owned and operated</strong>,
      <strong class="font-semibold text-white">owner supervised</strong> on every job,
      and fully insured.
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href={BUSINESS.phoneHref}
        class="inline-flex items-center gap-2 bg-cpf-red px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors hover:bg-cpf-red-dark"
      >
        Call {BUSINESS.phone}
      </a>
      <a
        href={withBase('/featured-work/')}
        class="inline-flex items-center gap-2 border-2 border-white/70 px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors hover:bg-white hover:text-ink"
      >
        See the work
      </a>
    </div>

    <p class="mt-6 font-display text-sm uppercase tracking-[0.16em] text-white/75">
      Building in the Conejo Valley since {BUSINESS.founded}
      <span class="mx-2 text-white/40">&middot;</span>
      {BUSINESS.licenseLabel}
    </p>
  </div>
</section>
