---
/**
 * Hero A/B — review build only, on the real homepage.
 *
 * A hero is judged in context: with the trust strip under it, the headline
 * sitting where it actually sits, and the page scrolling the way it actually
 * scrolls. Two candidates side by side on a separate review page compares
 * photographs; this compares home pages, which is the decision being made.
 *
 * Both render through <Hero>, so the photograph is the only variable.
 *
 * GATED TO THE DEMO BUILD, same IS_DEMO flag as the noindex and the Disallow
 * robots.txt, so it cannot drift out of sync with which build is which.
 * Production gets a single hero and no switch.
 *
 * DELETE THIS COMPONENT once the choice is made. It is scaffolding, and the
 * call site in index.astro falls back to a plain <Hero> in one line.
 */
import Hero from './Hero.astro';
import { A } from '../lib/assets';

const OPTIONS = [
  {
    key: 'A',
    asset: A.stoneEntry,
    name: 'stoneEntry (gbp-01)',
    detail: '1024x682 — every pixel that survived of it',
  },
  {
    key: 'B',
    asset: A.gardenWallStoneVeneerAndPorchClose,
    name: 'gardenWallStoneVeneerAndPorchClose',
    detail: '1920x1278 — nearly double, CPF sign in frame',
  },
];
---

{
  OPTIONS.map((o, i) => (
    <div data-hero-option={o.key} hidden={i !== 0}>
      <Hero asset={o.asset} label={`hero option ${o.key}`} eager={i === 0} />
    </div>
  ))
}

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-4 pb-20 md:pb-6"
  data-hero-switch
>
  <div class="pointer-events-auto flex items-center gap-1 bg-black/75 p-1.5 backdrop-blur-sm">
    <span class="px-2 font-display text-xs font-semibold uppercase tracking-[0.18em] text-white/60">
      Hero
    </span>
    {
      OPTIONS.map((o, i) => (
        <button
          type="button"
          data-hero-pick={o.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          title={`${o.name} — ${o.detail}`}
          class="px-3 py-1.5 font-display text-xs font-semibold uppercase tracking-widest text-white/70 transition-colors aria-pressed:bg-cpf-red aria-pressed:text-white hover:text-white"
        >
          {o.key}
        </button>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    const picks = [...document.querySelectorAll('[data-hero-pick]')];
    if (!picks.length) return;
    const KEY = 'cpf-hero-option';

    const show = (key) => {
      for (const box of document.querySelectorAll('[data-hero-option]')) {
        box.hidden = box.getAttribute('data-hero-option') !== key;
      }
      for (const b of picks) {
        b.setAttribute('aria-pressed', b.getAttribute('data-hero-pick') === key ? 'true' : 'false');
      }
      try {
        sessionStorage.setItem(KEY, key);
      } catch {
        /* blocked storage — the choice just will not persist */
      }
    };

    try {
      const saved = sessionStorage.getItem(KEY);
      if (saved) show(saved);
    } catch {}

    for (const b of picks) {
      b.addEventListener('click', () => show(b.getAttribute('data-hero-pick')));
    }
  })();
</script>
