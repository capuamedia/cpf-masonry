---
import Img from './Img.astro';
import type { Asset } from '../lib/assets';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  asset?: Asset;
  /** Section 4 slot table: service and project page headers cap at 1400px. */
  displayW?: number;
}
const { eyebrow, title, intro, asset, displayW = 1400 } = Astro.props;
---

{
  asset ? (
    <section class="relative isolate">
      <Img
        asset={asset}
        displayW={displayW}
        sizes="100vw"
        label={`page header: ${title}`}
        eager
        class="absolute inset-0 h-full w-full"
        imgClass="h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/55 to-black/25" aria-hidden="true" />
      <div class="relative mx-auto flex min-h-[46svh] max-w-7xl flex-col justify-end px-4 pb-12 pt-24 sm:px-6">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-cpf-yellow">{eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-[var(--text-h1)] font-bold uppercase text-white">{title}</h1>
        {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/90">{intro}</p>}
      </div>
    </section>
  ) : (
    <section class="border-b border-line bg-surface">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-3 max-w-3xl text-[var(--text-h1)] font-bold uppercase text-ink">{title}</h1>
        {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{intro}</p>}
      </div>
    </section>
  )
}
