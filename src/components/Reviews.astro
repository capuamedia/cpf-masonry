---
/**
 * Elfsight All-in-One Reviews, pulling the Yelp and Google listings together.
 *
 * Two widgets are configured in the Elfsight dashboard and this component
 * renders whichever `appId` names. "CPF Duo" is the default and is the compact
 * one; "CPF Full Reviews" is much taller and is used on /reviews/ only.
 *
 * Real reviews beat any claim the site can make about itself, so this sits
 * immediately before the call-to-action on the pages where someone is deciding
 * whether to phone.
 *
 * Notes on how it is embedded:
 *  - platform.js is `async` and the widget carries `data-elfsight-app-lazy`, so
 *    it does not block first paint and only initializes near the viewport.
 *  - The container reserves a min-height. Third-party embeds are the usual
 *    cause of layout shift on an otherwise CLS-free page, and everything else
 *    here declares explicit dimensions.
 *  - preconnect is emitted so the CDN handshake overlaps with page render.
 *
 * If the widget is ever removed, the static rating summary in the footer and on
 * the contact page still stands on its own.
 */
interface Props {
  heading?: string;
  eyebrow?: string;
  intro?: string;
  /** Set false on a surface that already sits on --color-surface. */
  tinted?: boolean;
  /**
   * Internal href for a "read them all" link under the widget. Omitted on
   * /reviews/ itself — the widget there is already the full set, and a link
   * back to the page you are standing on is noise.
   */
  moreHref?: string;
  moreLabel?: string;
  /**
   * Elfsight widget id. Two exist, and they are not interchangeable:
   *
   *   CPF Duo           2039d26f-... the compact pair, for the section that
   *                     sits at the foot of the home and contact pages.
   *   CPF Full Reviews  75ef0de3-... the full set. Considerably taller, so it
   *                     only belongs on /reviews/, where the reviews are the
   *                     page rather than a closing note.
   */
  appId?: string;
  /**
   * Reserved height in px, to stop the embed shifting layout as it mounts.
   * Third-party embeds are the usual cause of CLS on a page where everything
   * else declares explicit dimensions. Match this to the widget: the full set
   * needs far more room than the duo.
   */
  minHeight?: number;
}

const {
  heading = 'What our customers say',
  eyebrow = 'Reviews',
  intro = 'Rated 5.0 on both Yelp and Google. These come straight from those listings — nothing on this page is written by us.',
  tinted = true,
  moreHref,
  moreLabel = 'Read all the reviews',
  appId = '2039d26f-733e-4d1f-9c68-4bdaa8e5a85e',
  minHeight = 420,
} = Astro.props;
---

<section class={tinted ? 'border-t border-line bg-surface py-20' : 'py-20'}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">{heading}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{intro}</p>
    </div>

    <!-- Elfsight All-in-One Reviews. Which widget is the `appId` prop. -->
    <div class="mt-10" style={`min-height:${minHeight}px`} data-elfsight-container>
      <div class={`elfsight-app-${appId}`} data-elfsight-app-lazy></div>
    </div>

    {moreHref && (
      <p class="mt-8 text-center">
        <a
          class="inline-block border-2 border-cpf-black px-6 py-3 font-display text-base font-semibold uppercase tracking-wide text-ink transition-colors hover:bg-cpf-black hover:text-white"
          href={moreHref}
          >{moreLabel}</a
        >
      </p>
    )}

    <noscript>
      <p class="mt-6 text-center text-muted">
        Reviews need JavaScript to load. CPF is rated 5.0 on
        <a class="text-cpf-red underline" href="https://www.yelp.com/" rel="noopener nofollow">Yelp</a>
        and 5.0 on Google.
      </p>
    </noscript>
  </div>
</section>

{/*
  No loader here. platform.js is emitted once sitewide by ElfsightLoader.astro
  in the layout, because the floating badge needs it on every page — emitting it
  here as well would double it up on the two pages carrying both widgets.
*/}
