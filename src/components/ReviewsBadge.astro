---
/**
 * Elfsight floating reviews badge — sitewide.
 *
 * COLLISION NOTE. This site already has a fixed element pinned to the bottom of
 * the viewport on mobile: the sticky call bar in Layout.astro. For a contractor
 * the phone call IS the conversion, so if the two ever overlap, the badge gives
 * way — never the call button.
 *
 * Elfsight positions its floating widgets itself and portals them out of this
 * container, so the guard below is written defensively: it lifts the widget's
 * own fixed wrapper clear of the call bar on small screens, matching whichever
 * corner it settles in. The offset is a single custom property so it can be
 * tuned without hunting through selectors.
 *
 * The call bar is `md:hidden`, so above 768px there is nothing to avoid and the
 * badge sits wherever Elfsight puts it.
 */
---

<div class="elfsight-app-b264d3c7-506f-49e7-989e-31b7555fa5b1" data-elfsight-app-lazy></div>

<style is:global>
  /* Height of the sticky call bar: py-3.5 (0.875rem x2) + ~1.5rem line box,
     plus the iOS home-indicator inset, plus a little breathing room. */
  :root {
    --cpf-callbar-clearance: calc(4.25rem + env(safe-area-inset-bottom));
  }

  @media (max-width: 767px) {
    /* Elfsight's own floating wrapper, whatever it ends up being called. */
    [class*='elfsight-app-b264d3c7'] [style*='position: fixed'],
    [class*='elfsight-app-b264d3c7'] [class*='fixed'],
    div[data-elfsight-app-id='b264d3c7-506f-49e7-989e-31b7555fa5b1'] {
      bottom: var(--cpf-callbar-clearance) !important;
    }
  }
</style>
