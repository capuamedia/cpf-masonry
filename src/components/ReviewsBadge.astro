---
/**
 * Elfsight floating reviews badge — sitewide.
 *
 * COLLISION WITH THE CALL BAR
 * ---------------------------
 * This site pins a sticky call bar to the bottom of the viewport below 768px.
 * For a contractor the phone call IS the conversion, so the badge gives way —
 * never the call button.
 *
 * Why this needs a CSS override rather than an Elfsight dashboard setting:
 * the widget's own configuration is `bottom-right` with a 20px vertical offset,
 * but the bundle discards that on small screens and hardcodes a bottom-centred
 * position instead:
 *
 *   re ? { position: 'bottom', verticalOffset: 20, horizontalOffset: 0 } : i
 *
 * — where `i` is the configured value. So changing the offset in the Elfsight
 * editor moves it on desktop and does nothing on mobile, which is the only
 * place the two actually collide.
 *
 * Why the selector targets inline styles rather than class names: the widget is
 * built with styled-components, so every class is a generated hash that changes
 * between releases. The positioning, however, is applied as an inline style —
 *
 *   e.split('-').length === 1 ? { position: 'fixed', [e]: '20px' } : { ... }
 *
 * — which is stable, because it is the widget's actual behaviour rather than an
 * implementation detail of its build. Both serialisations of the style
 * attribute are matched: React writes `position:fixed` without a space, and the
 * browser rewrites it with one as soon as anything touches the CSSOM.
 *
 * TO TUNE: change --cpf-badge-clearance below. That is the only number here.
 */
---

<div class="elfsight-app-b264d3c7-506f-49e7-989e-31b7555fa5b1" data-elfsight-app-lazy></div>

<style is:global>
  :root {
    /*
      Sticky call bar height: py-3.5 top and bottom (1.75rem) plus a ~1.75rem
      content line = 3.5rem, then the iOS home-indicator inset, then a 1.25rem
      gap so the badge reads as a separate element rather than stacked on it.
    */
    --cpf-badge-clearance: calc(4.75rem + env(safe-area-inset-bottom, 0px));
  }

  @media (max-width: 767px) {
    /* Scoped form: the wrapper still inside our container. */
    .elfsight-app-b264d3c7-506f-49e7-989e-31b7555fa5b1 [style*='position:fixed'],
    .elfsight-app-b264d3c7-506f-49e7-989e-31b7555fa5b1 [style*='position: fixed'],
    /*
      Fallback for when the widget portals its wrapper out to <body>, which it
      does for popup content. Keyed on the widget's own 20px offset so it cannot
      match anything of ours — the call bar is positioned with Tailwind classes,
      not an inline style, so it is untouched by this.
    */
    body > [style*='position:fixed'][style*='bottom:20px'],
    body > [style*='position: fixed'][style*='bottom: 20px'] {
      bottom: var(--cpf-badge-clearance) !important;
    }
  }

  /* Keep the badge under the call bar in stacking order too, so if it ever does
     overlap, the call button stays tappable. The bar sits at z-50. */
  @media (max-width: 767px) {
    .elfsight-app-b264d3c7-506f-49e7-989e-31b7555fa5b1 {
      z-index: 40;
    }
  }
</style>
