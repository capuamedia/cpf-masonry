 * Legacy URL: /concrete-countertops/ (WP page ID 80).
 *
 * The prose is the owner's, from the recovered page, lightly reset for the new
 * layout — his argument, his claims, his voice. Two details preserved
 * deliberately: "since long before they became the new trend", and the 1993
 * date for custom concrete specifically. 1993 is not in conflict with
 * BUSINESS.founded (1991) — the business predates the countertop work.
 */
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { A } from '../lib/assets';
import { withBase } from '../lib/urls';

const showcase = [
  { asset: A.blackConcreteCountertops,
    caption: 'Black concrete countertops, cast and polished.' },
  { asset: A.blackConcreteCountertopsWithBarbecue,
    caption: 'The same run carried through an outdoor barbecue counter.' },
  { asset: A.kitchenConcreteCountertopsReadyForSinkInstall,
    caption: 'Kitchen countertops cast in place and ready for the sink to drop in.' },
  { asset: A.polishedStoneCountertops,
    caption: 'Polished stone countertops — the largest file in the archive, at 1920px.' },
  { asset: A.backyardCustomConcreteCountertopBarbecueSetup,
    caption: 'Backyard barbecue counter with a cast concrete top.' },
  { asset: A.concreteCountertopCloseup,
    caption: 'Close on the finish: concrete takes a polish that reads as stone.' },
];

const gallery = [
  A.closeupOutdoorConcreteCountertop,
  A.concreteKitchenCounterCloseup,
  A.backyardConcreteCountertopFireFeature,
  A.backyardConcreteCountertopFireFeature2,
  A.outdoorConcreteCountertopProgressShot,
  A.outdoorConcreteCountertopProgressShot2,
