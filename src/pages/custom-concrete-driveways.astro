---
/**
 * Legacy URL: /custom-concrete-driveways/ (WP page ID 192).
 *
 * RETIRED 2026-09-19 — consolidated into /custom-concrete/, which now carries
 * the driveway photographs under its own #driveways heading. Two pages chasing
 * the same stamped-concrete terms were splitting the signal between them.
 *
 * This file stays, and must keep staying. The URL is one of the fifteen the
 * old site published (tools/legacy-urls.mjs), it carries twenty years of
 * indexing, and deleting it would drop that on the floor. It redirects instead:
 *
 *   - Cloudflare (production) issues a real 301 from public/_redirects.
 *   - GitHub Pages cannot redirect, so this page's meta refresh carries it.
 *   - The canonical points at /custom-concrete/ on every target, which is what
 *     actually moves the ranking signal across.
 *
 * The visible copy is for the rare visitor who lands here with JavaScript and
 * meta refresh both disabled, and for anyone reading a cached copy.
 */
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/urls';

const TO = '/custom-concrete/';
---

<Layout
  title="Custom Concrete Driveways"
  description="Custom concrete driveways in Thousand Oaks, Newbury Park and Ventura County — stamped, colored and paver driveways. Now part of the custom and stamped concrete page."
  redirectTo={TO}
>
  <section class="mx-auto flex min-h-[50svh] max-w-3xl flex-col justify-center px-4 py-24 sm:px-6">
    <p class="eyebrow">Custom Concrete</p>
    <h1 class="mt-3 text-[var(--text-h1)] font-semibold uppercase">
      Concrete driveways have moved
    </h1>
    <hr class="rule-red mt-5" />
    <p class="mt-6 text-lg leading-relaxed text-ink-soft">
      Driveway work now sits with the rest of the stamped and poured concrete,
      on one page. If you are not taken there automatically:
    </p>
    <p class="mt-6">
      <a
        href={withBase(TO + '#driveways')}
        class="inline-flex items-center gap-2 bg-cpf-red px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors hover:bg-cpf-red-dark"
      >
        Custom &amp; stamped concrete driveways
      </a>
    </p>
  </section>
</Layout>
