---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Reviews from '../components/Reviews.astro';
import PlaceholderNote from '../components/PlaceholderNote.astro';
import { A } from '../lib/assets';
import { BUSINESS } from '../lib/site';
import { withBase } from '../lib/urls';
import { CONFIRMED_PAIRS } from '../lib/pairs';

const services = [
  {
    href: '/services/concrete/',
    title: 'Custom & Stamped Concrete',
    blurb:
      'Driveways, pavers, patios and countertops — designed, formed and poured. Stamped finishes in the patterns and colours that suit the house.',
    asset: A.stampedDriveway,
  },
  {
    href: '/services/masonry/',
    title: 'Block, Brick & Stone',
    blurb:
      'Foundations, retaining walls, property-line block walls, brick and natural stone veneer. Engineered to hold a Conejo Valley slope.',
    asset: A.dosVientosWall,
  },
  {
    href: '/services/outdoor/',
    title: 'Outdoor Kitchens & Fireplaces',
    blurb:
      'Backyard kitchens, fireplaces, fire pits and seating walls, built in stone and brick to sit with the pool and the planting.',
    asset: A.stoneFireplaceTall,
  },
];

const projects = [
  {
    href: '/projects/triunfo-ymca-baseball-fields/',
    eyebrow: 'Community project',
    title: 'Triunfo YMCA Baseball Fields',
    blurb:
      'Backstops, dugouts, outfield walls and the concrete flatwork tying them together — delivered directly with the YMCA.',
    asset: A.ymcaBackstop,
  },
  {
    href: '/projects/robertson-family-field-viewpoint-school/',
    eyebrow: 'Institutional',
    title: 'Robertson Family Field, Viewpoint School',
    blurb:
      'The Calabasas follow-up to Triunfo: a full baseball field build for a private school campus.',
    asset: A.viewpointDiamond,
  },
];

const gallery = [
  A.pergolaLounge, A.roseWalkway, A.poolWaterFeature,
  A.herringboneClose, A.gazeboLawn, A.curvedRoseWalk,
];

const description =
  'Masonry and concrete contractor serving Newbury Park, Thousand Oaks and the Conejo Valley. Stamped concrete, block walls, natural stone, outdoor kitchens. Guaranteed completion dates, fully insured. CA License #878989.';
---

<Layout title="home" description={description}>
  <!-- ================= HERO ================= -->
  <section class="relative isolate">
    <Img
      asset={A.brickWallRailing}
      displayW={1900}
      sizes="100vw"
      label="homepage hero"
      eager
      class="absolute inset-0 h-full w-full"
      imgClass="h-full w-full object-cover object-center"
    />
    <!-- Scrim from the bottom so the headline holds contrast over a bright,
         high-key photograph without washing the brickwork out. -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/15"
      aria-hidden="true"
    >
    </div>

    {/*
      Sits in the upper band of the hero, which is empty — the headline block is
      bottom-aligned — so it flags the slot without covering the thing being
      reviewed. Demo build only; see PlaceholderNote.astro.
    */}
    <PlaceholderNote
      id="hero"
      label="Placeholder — review build"
      headline="Replace with drone footage"
      detail="Static hero for now: this is the highest-resolution photograph that survived the old site, at 1900px. Drone video will fill this slot properly."
    />

    <div class="relative mx-auto flex min-h-[78svh] max-w-7xl flex-col justify-end px-4 pb-14 pt-28 sm:px-6 md:min-h-[82svh]">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-cpf-yellow">
        Newbury Park &middot; Thousand Oaks &middot; Conejo Valley
      </p>
      <h1 class="mt-3 max-w-3xl text-[var(--text-hero)] font-bold uppercase text-white">
        Concrete and masonry that gets finished
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/90">
        Foundations, stamped concrete, natural stone, block walls and brick —
        with a <strong class="font-semibold text-white">guaranteed completion date</strong>
        and <strong class="font-semibold text-white">full insurance coverage</strong> on every job.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href={BUSINESS.phoneHref}
          class="inline-flex items-center gap-2 bg-cpf-red px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors hover:bg-cpf-red-dark"
        >
          Call {BUSINESS.phone}
        </a>
        <a
          href={withBase('/projects/')}
          class="inline-flex items-center gap-2 border-2 border-white/70 px-6 py-3.5 font-display text-lg font-semibold uppercase tracking-wide text-white transition-colors hover:bg-white hover:text-ink"
        >
          See the work
        </a>
      </div>

      <p class="mt-6 font-display text-sm uppercase tracking-[0.16em] text-white/75">
        {BUSINESS.licenseLabel}
      </p>
    </div>
  </section>

  <!-- ================= TRUST STRIP ================= -->
  <section class="border-b border-line bg-surface">
    <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-line px-0 sm:grid-cols-4">
      {
        [
          { k: 'Guaranteed', v: 'Completion dates' },
          { k: 'Fully', v: 'Insured' },
          { k: '5.0 stars', v: 'Yelp & Google' },
          { k: 'Licensed', v: `CSLB #${BUSINESS.license}` },
        ].map((s) => (
          <li class="bg-surface px-4 py-6 text-center">
            <p class="font-display text-2xl font-semibold uppercase leading-none text-cpf-red">{s.k}</p>
            <p class="mt-1.5 font-display text-sm uppercase tracking-[0.14em] text-muted">{s.v}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= PITCH ================= -->
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="eyebrow">Independent consulting and contracting</p>
    <h2 class="mt-3 text-[var(--text-h2)] font-semibold uppercase">
      The trade most homeowners worry about is the one that turns up
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">
      CPF specialises in foundations, stamped concrete, natural stone, block walls
      and brick products. Project expertise runs from large-scale renovations to
      smaller residential jobs, and clients get the peace of mind that comes with a
      guaranteed completion date and full insurance coverage — with tenacious
      attention to detail and pride of accomplishment on every pour and every course.
    </p>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
    <div class="mb-9 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">What we build</p>
        <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">Services</h2>
      </div>
      <a href={withBase('/services/')} class="hidden shrink-0 font-display text-base font-semibold uppercase tracking-wide text-cpf-red hover:underline sm:block">
        All services &rarr;
      </a>
    </div>

    <ul class="grid gap-8 md:grid-cols-3">
      {
        services.map((s) => (
          <li class="group">
            <a href={withBase(s.href)} class="block">
              {/* 678px source, laid out at 500px — the tier ceiling. Above that
                  it stops being sharp on a retina phone, which is most of the
                  traffic for a contractor. */}
              <Img
                asset={s.asset}
                displayW={500}
                sizes="(max-width: 768px) 100vw, 33vw"
                label={`home service card: ${s.title}`}
                imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <h3 class="mt-4 font-display text-2xl font-semibold uppercase leading-tight text-ink group-hover:text-cpf-red">
                {s.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{s.blurb}</p>
              <p class="mt-3 font-display text-sm font-semibold uppercase tracking-wider text-cpf-red">
                Read more &rarr;
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= TEXTURE BAND ================= -->
  <!--
    gbp-06 is the highest-resolution masonry SURFACE in the set, but it carries
    visible efflorescence — white salt bloom — across parts of the frame. A
    prospective customer reads that as a bad paving job even though the work is
    sound, so the band is kept shallow and the crop biased low, showing the
    clean lower courses rather than the bloomed upper area.
  -->
  <section class="relative isolate" aria-hidden="true">
    <Img
      asset={A.pavingTexture}
      displayW={2100}
      sizes="100vw"
      label="homepage texture band"
      class="h-32 w-full sm:h-44"
      imgClass="h-32 sm:h-44 w-full object-cover object-[50%_78%]"
    />
  </section>

  <!-- ================= BEFORE / AFTER ================= -->
  {
    CONFIRMED_PAIRS.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Before and after</p>
          <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">
            What the ground looked like first
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">
            Finished photographs only tell half of it. Drag the handle to see the
            state of the site before the crew started.
          </p>
        </div>
        <div class="mx-auto mt-10 max-w-[900px]">
          {CONFIRMED_PAIRS.map((pair, i) => (
            <BeforeAfter pair={pair} id={`home-${i}`} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ================= FEATURED PROJECTS ================= -->
  <section class="bg-surface py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="eyebrow">Featured projects</p>
        <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">
          Work most residential masons cannot show you
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Two community and institutional ballfield builds — the kind of job that
          gets awarded on scheduling and insurance as much as on the masonry.
        </p>
      </div>

      <ul class="grid gap-10 md:grid-cols-2">
        {
          projects.map((p) => (
            <li class="group">
              <a href={withBase(p.href)} class="block">
                <Img
                  asset={p.asset}
                  displayW={500}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  label={`home project card: ${p.title}`}
                  imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <p class="mt-4 eyebrow">{p.eyebrow}</p>
                <h3 class="mt-1.5 font-display text-2xl font-semibold uppercase leading-tight text-ink group-hover:text-cpf-red">
                  {p.title}
                </h3>
                <p class="mt-2 leading-relaxed text-muted">{p.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= GALLERY TEASER ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="mb-9">
      <p class="eyebrow">Recent work</p>
      <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">Around the Conejo Valley</h2>
    </div>
    {/* Portrait and landscape sources mixed, so this is a balanced column
        layout rather than a fixed grid — no portrait photo gets force-cropped
        into a wide band. */}
    <div class="columns-2 gap-4 sm:gap-5 lg:columns-3">
      {
        gallery.map((asset, i) => (
          <div class="mb-4 break-inside-avoid sm:mb-5">
            <Img
              asset={asset}
              displayW={500}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 380px"
              label={`home gallery ${i}`}
              lightbox
              imgClass="w-full h-auto"
            />
          </div>
        ))
      }
    </div>
    <p class="mt-8">
      <a href={withBase('/projects/')} class="font-display text-lg font-semibold uppercase tracking-wide text-cpf-red hover:underline">
        See the full gallery &rarr;
      </a>
    </p>
  </section>

  <!-- ================= REVIEWS ================= -->
  <!-- Placed immediately before the call-to-action: social proof lands hardest
       at the point someone is deciding whether to pick up the phone. -->
  <Reviews />

  <!-- ================= CTA ================= -->
  <section class="bg-cpf-black py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-[var(--text-h2)] font-semibold uppercase">Get a date, not a maybe</h2>
      <p class="mt-4 text-lg text-white/80">
        Tell us what you are building and where. You will get a straight answer on
        scope, price and when it will be finished.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={BUSINESS.phoneHref} class="bg-cpf-red px-7 py-4 font-display text-xl font-semibold uppercase tracking-wide text-white hover:bg-cpf-red-dark">
          {BUSINESS.phone}
        </a>
        <a href={withBase('/contact/')} class="border-2 border-white/70 px-7 py-4 font-display text-xl font-semibold uppercase tracking-wide text-white hover:bg-white hover:text-ink">
          Contact
        </a>
      </div>
      <p class="mt-6 font-display text-sm uppercase tracking-[0.16em] text-white/55">
        Serving {BUSINESS.serviceArea.join(' · ')}
      </p>
    </div>
  </section>
</Layout>
