---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Hero from '../components/Hero.astro';
import Reviews from '../components/Reviews.astro';
import { A } from '../lib/assets';
import { BUSINESS, YEARS_IN_BUSINESS } from '../lib/site';
import { withBase } from '../lib/urls';
import { CONFIRMED_PAIRS } from '../lib/pairs';

const services = [
  {
    href: '/custom-concrete/',
    title: 'Custom & Stamped Concrete',
    blurb:
      'Driveways, pavers, patios and countertops — designed, formed and poured. Stamped finishes in the patterns and colors that suit the house.',
    asset: A.stampedDriveway,
  },
  {
    href: '/masonry/',
    title: 'Block, Brick & Stone',
    blurb:
      'Foundations, retaining walls, property-line block walls, brick and natural stone veneer. Engineered to hold a Conejo Valley slope.',
    asset: A.dosVientosWall,
  },
  {
    href: '/fireplaces-and-barbecues/',
    title: 'Outdoor Kitchens & Fireplaces',
    blurb:
      'Backyard kitchens, fireplaces, fire pits and seating walls, built in stone and brick to sit with the pool and the planting.',
    asset: A.stoneFireplaceTall,
  },
];

const projects = [
  {
    /* Residential leads: it is what most visitors are actually looking for,
       and it is the project that was invisible until the site came back. */
    href: '/featured-project-dos-vientos-villa/',
    eyebrow: 'Residential',
    title: 'Dos Vientos Villa',
    blurb:
      'A full exterior remodel in Newbury Park — stamped concrete driveway, custom stone walls and pillars, a stone-pillared patio and a serpentine tiled outdoor kitchen.',
    /* Not dosVientosWall: the masonry service card above already uses it, and
       the same photograph twice on one page reads as a thin portfolio. This is
       the villa's own covered patio, which the blurb names. */
    asset: A.pergolaPatio,
  },
  {
    href: '/featured-project-triunfo-ymca-baseball-fields/',
    eyebrow: 'Community project',
    title: 'Triunfo YMCA Baseball Fields',
    blurb:
      'Backstops, dugouts, outfield walls and the concrete flatwork tying them together — delivered directly with the YMCA.',
    asset: A.ymcaBackstop,
  },
  {
    href: '/featured-project-robertson-family-field-viewpoint-school/',
    eyebrow: 'Institutional',
    title: 'Robertson Family Field, Viewpoint School',
    blurb:
      'The Calabasas follow-up to Triunfo: a full baseball field build for a private school campus.',
    asset: A.viewpointDiamond,
  },
];

/** 2025-26 work. The only current photography on the site — see the section comment. */
const recentWork = [
  A.naturalStoneStepsStackedStoneRetainingWall,
  A.hillsideBlockRetainingWallConstruction,
  A.flagstonePatioBackyardDiningArea,
  A.blockWallBrickCapRaisedPlanter,
  A.curvedStructuralRetainingWallFinishedFace,
  A.brickEntryWalkwayCurvedPlanterWalls,
];

const gallery = [
  A.pergolaLounge, A.roseWalkway, A.poolWaterFeature,
  A.herringboneClose, A.curvedDrive, A.curvedRoseWalk,
];

const description =
  'Masonry and concrete contractor in the Conejo Valley since 1991. Stamped concrete, block walls, natural stone and outdoor kitchens across Newbury Park, Thousand Oaks and Westlake Village. Family owned, owner supervised, fully insured. CA License #878989, C-29 / C-8.';
---

<Layout title="home" description={description}>
  <!-- ================= HERO ================= -->
  {/* stoneEntryHero, not stoneEntry: the upscaled copy, hero slot only.
      See the note on the asset before reusing it. */}
  <Hero asset={A.stoneEntryHero} />

  <!-- ================= TRUST STRIP ================= -->
  <section class="border-b border-line bg-surface">
    <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-line px-0 sm:grid-cols-4">
      {
        [
          { k: `Since ${BUSINESS.founded}`, v: `${YEARS_IN_BUSINESS} years in the valley` },
          { k: 'Owner', v: 'Supervised' },
          { k: 'Fully', v: 'Insured' },
          { k: '5.0 stars', v: 'Yelp & Google' },
        ].map((s) => (
          <li class="bg-surface px-4 py-6 text-center">
            <p class="font-display text-2xl font-semibold uppercase leading-none text-cpf-red">{s.k}</p>
            <p class="mt-1.5 font-display text-sm uppercase tracking-[0.14em] text-muted">{s.v}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= PITCH ================= -->
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="eyebrow">Independent consulting and contracting</p>
    <h2 class="mt-3 text-[var(--text-h2)] font-semibold uppercase">
      The trade most homeowners worry about is the one that turns up
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">
      CPF has specialized in foundations, stamped concrete, natural stone, block
      walls and brick products across the Conejo Valley since 1991. Project expertise runs from large-scale renovations to
      smaller residential jobs. Every project is owner supervised, which is what
      keeps the attention to detail on every pour and every course — we are the
      first in and the last out when starting a brand new home.
    </p>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
    <div class="mb-9 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">What we build</p>
        <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">Services</h2>
      </div>
      <a href={withBase('/services/')} class="hidden shrink-0 font-display text-base font-semibold uppercase tracking-wide text-cpf-red hover:underline sm:block">
        All services &rarr;
      </a>
    </div>

    <ul class="grid gap-8 md:grid-cols-3">
      {
        services.map((s) => (
          <li class="group">
            <a href={withBase(s.href)} class="block">
              {/* 678px source, laid out at 500px — the tier ceiling. Above that
                  it stops being sharp on a retina phone, which is most of the
                  traffic for a contractor. */}
              <Img
                asset={s.asset}
                displayW={500}
                sizes="(max-width: 768px) 100vw, 33vw"
                label={`home service card: ${s.title}`}
                imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <h3 class="mt-4 font-display text-2xl font-semibold uppercase leading-tight text-ink group-hover:text-cpf-red">
                {s.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{s.blurb}</p>
              <p class="mt-3 font-display text-sm font-semibold uppercase tracking-wider text-cpf-red">
                Read more &rarr;
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= TEXTURE BAND ================= -->
  <!--
    gbp-06 is the highest-resolution masonry SURFACE in the set, but it carries
    visible efflorescence — white salt bloom — across parts of the frame. A
    prospective customer reads that as a bad paving job even though the work is
    sound, so the band is kept shallow and the crop biased low, showing the
    clean lower courses rather than the bloomed upper area.
  -->
  <section class="relative isolate" aria-hidden="true">
    <Img
      asset={A.pavingTexture}
      displayW={2100}
      sizes="100vw"
      label="homepage texture band"
      class="h-32 w-full sm:h-44"
      imgClass="h-32 sm:h-44 w-full object-cover object-[50%_78%]"
    />
  </section>

  <!-- ================= BEFORE / AFTER ================= -->
  {
    CONFIRMED_PAIRS.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Before and after</p>
          <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">
            What the ground looked like first
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">
            Finished photographs only tell half of it. Drag the handle to see the
            state of the site before the crew started.
          </p>
        </div>
        <div class="mx-auto mt-10 max-w-[900px]">
          {CONFIRMED_PAIRS.map((pair, i) => (
            <BeforeAfter pair={pair} id={`home-${i}`} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ================= FEATURED PROJECTS ================= -->
  <section class="bg-surface py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="eyebrow">Featured projects</p>
        <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">
          One house, and two jobs most residential masons cannot show you
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          A full residential exterior remodel, plus two community and
          institutional ballfield builds — the kind of job that gets awarded on
          insurance and references as much as on the masonry.
        </p>
      </div>

      {/* Three across now that Dos Vientos is here — at md:grid-cols-2 the third
          project sat alone on its own row with a hole beside it. */}
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p) => (
            <li class="group">
              <a href={withBase(p.href)} class="block">
                <Img
                  asset={p.asset}
                  displayW={500}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  label={`home project card: ${p.title}`}
                  imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <p class="mt-4 eyebrow">{p.eyebrow}</p>
                <h3 class="mt-1.5 font-display text-2xl font-semibold uppercase leading-tight text-ink group-hover:text-cpf-red">
                  {p.title}
                </h3>
                <p class="mt-2 leading-relaxed text-muted">{p.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= GALLERY TEASER ================= -->
  <!-- ================= RECENT WORK ================= -->
  <!--
    The 2025-26 photographs. Everything else on this site is from 2016 or
    earlier, because that is when the old site stopped being updated — so this
    section carries the whole weight of showing the business is still working.
    Dated deliberately for that reason.

    Portrait sources at 3024-4284px, cropped 3:2. They are the sharpest files
    here by a wide margin, which is why the joint work is legible at this size.
  -->
  <section class="border-t border-line bg-surface py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="eyebrow">Recent work</p>
      <h2 class="mt-3 text-[var(--text-h2)] font-semibold uppercase">Built in 2025 and 2026</h2>
      <hr class="rule-red mt-4" />
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Hillside retaining walls, flagstone patios, sandstone steps and brickwork
        across Ventura County — photographed on site as the work came off the
        trowel.
      </p>

      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          recentWork.map((asset, i) => (
            <li>
              <Img
                asset={asset}
                displayW={500}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                label={`recent work ${i}`}
                lightbox
                imgClass="aspect-[3/2] w-full object-cover"
              />
              <p class="mt-3 text-sm leading-relaxed text-muted">{asset.alt}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="mb-9">
      <p class="eyebrow">Gallery</p>
      <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase">Around the Conejo Valley</h2>
    </div>
    {/* Portrait and landscape sources mixed, so this is a balanced column
        layout rather than a fixed grid — no portrait photo gets force-cropped
        into a wide band. */}
    <div class="columns-2 gap-4 sm:gap-5 lg:columns-3">
      {
        gallery.map((asset, i) => (
          <div class="mb-4 break-inside-avoid sm:mb-5">
            <Img
              asset={asset}
              displayW={500}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 380px"
              label={`home gallery ${i}`}
              lightbox
              imgClass="w-full h-auto"
            />
          </div>
        ))
      }
    </div>
    <p class="mt-8">
      <a href={withBase('/featured-work/')} class="font-display text-lg font-semibold uppercase tracking-wide text-cpf-red hover:underline">
        See the full gallery &rarr;
      </a>
    </p>
  </section>

  <!-- ================= REVIEWS ================= -->
  <!-- Placed immediately before the call-to-action: social proof lands hardest
       at the point someone is deciding whether to pick up the phone. -->
  <Reviews moreHref={withBase('/reviews/')} />

  <!-- ================= CTA ================= -->
  <section class="bg-cpf-black py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-[var(--text-h2)] font-semibold uppercase">Schedule an estimate</h2>
      <p class="mt-4 text-lg text-white/80">
        Tell us what you are building and where, and we will discuss how we can
        accommodate your needs. You will get a straight answer on scope and price
        from the person who will be on site.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={BUSINESS.phoneHref} class="bg-cpf-red px-7 py-4 font-display text-xl font-semibold uppercase tracking-wide text-white hover:bg-cpf-red-dark">
          {BUSINESS.phone}
        </a>
        <a href={withBase('/contact-us/')} class="border-2 border-white/70 px-7 py-4 font-display text-xl font-semibold uppercase tracking-wide text-white hover:bg-white hover:text-ink">
          Contact
        </a>
      </div>
      <p class="mt-6 font-display text-sm uppercase tracking-[0.16em] text-white/55">
        Serving {BUSINESS.serviceArea.join(' · ')}
      </p>
    </div>
  </section>
</Layout>
