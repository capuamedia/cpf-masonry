---
/**
 * PAIRING REVIEW — demo build only. Never exists in production.
 *
 * Three before/after candidates are staged in src/lib/pairs.ts with
 * `confirmed: false` and deliberately render nowhere on the site. The blocker
 * was never technical: pairing two photographs that are not the same job makes
 * a contractor look like he is passing off someone else's work, and only the
 * owner can rule on it. This page lays each candidate out for that decision and
 * does nothing else.
 *
 * Why a dynamic route: getStaticPaths returning [] emits no page at all, so the
 * production build carries no trace of this. A plain .astro page would still be
 * reachable at cpf-masonry.com/review/pairings/ with the internal notes on it,
 * noindexed or not. That is not a risk worth running.
 */
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { PAIRS, CANDIDATE_PAIRS, CONFIRMED_PAIRS, type Pair } from '../../lib/pairs';
import { IS_DEMO, withBase } from '../../lib/urls';

export function getStaticPaths() {
  return IS_DEMO ? [{ params: { slug: 'pairings' } }] : [];
}

/** Full frames sit two-up on desktop; portrait sliders must not tower. */
const FRAME_W = 620;
const isPortrait = (p: Pair) => p.before.img.height > p.before.img.width;
const sliderW = (p: Pair) => (isPortrait(p) ? 460 : 900);
const dims = (p: Pair) => `${p.before.img.width}x${p.before.img.height}`;

---

<Layout
  title="Pairing review"
  description="Internal review page for unconfirmed before/after pairings."
>
  <section class="border-b border-line bg-cpf-black">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-cpf-yellow">
        Internal — not part of the site
      </p>
      <h1 class="mt-3 max-w-4xl text-[var(--text-h1)] font-bold uppercase text-white">
        Before / after pairings
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-white/85">
        {CANDIDATE_PAIRS.length > 0
          ? `${CANDIDATE_PAIRS.length} candidate pairing${CANDIDATE_PAIRS.length === 1 ? ' is' : 's are'} built and working but held back from the site. Each shows both photographs at full size, then the slider exactly as it would publish. The only question is whether the two frames are genuinely the same job — a mismatched pair reads as passing off someone else's work, so these wait on your eye rather than mine.`
          : 'Nothing is waiting on you here. Every staged pairing has been ruled on, and the confirmed ones are live on the site. This page stays because the next batch of photographs will need the same call.'}
      </p>
      <p class="mt-4 max-w-3xl text-white/70">
        The hero A/B is not here — it is on this build&rsquo;s home page, where a
        hero is actually judged. Switch between them with the control at the
        bottom of the screen.
      </p>
      <p class="mt-4 max-w-3xl text-white/70">
        This page exists only on the review build. It is noindexed, unlinked, and
        emits nothing at all in the production build.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    {CANDIDATE_PAIRS.length > 0 && (
      <>
        <p class="eyebrow">The call</p>
        <h2 class="mt-2 mb-12 text-[var(--text-h2)] font-semibold uppercase text-ink">
          Which pairings can go live?
        </h2>
      </>
    )}

    <ol class="space-y-20">
      {CANDIDATE_PAIRS.map((pair, i) => (
        <li class="scroll-mt-8" id={`candidate-${i + 1}`}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line pb-4">
            <span class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-cpf-red">
              Candidate {i + 1} of {CANDIDATE_PAIRS.length}
            </span>
            <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-ink">
              {pair.title}
            </h2>
            <code class="text-sm text-muted">
              {pair.sources.before} &rarr; {pair.sources.after} &middot; {dims(pair)}
            </code>
          </div>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            <figure class="m-0">
              <figcaption class="mb-2 flex items-center justify-between gap-3">
                <span class="bg-cpf-black px-2.5 py-1 font-display text-xs font-semibold uppercase tracking-[0.14em] text-white">
                  Before
                </span>
                <code class="text-xs text-muted">{pair.sources.before}</code>
              </figcaption>
              <Img
                asset={pair.before}
                displayW={FRAME_W}
                sizes={`(max-width: 640px) 100vw, ${FRAME_W}px`}
                label={`review frame before (${pair.sources.before})`}
                lightbox
                imgClass="block w-full h-auto"
              />
              <p class="mt-2 text-sm leading-relaxed text-muted">{pair.before.alt}</p>
            </figure>

            <figure class="m-0">
              <figcaption class="mb-2 flex items-center justify-between gap-3">
                <span class="bg-cpf-red px-2.5 py-1 font-display text-xs font-semibold uppercase tracking-[0.14em] text-white">
                  After
                </span>
                <code class="text-xs text-muted">{pair.sources.after}</code>
              </figcaption>
              <Img
                asset={pair.after}
                displayW={FRAME_W}
                sizes={`(max-width: 640px) 100vw, ${FRAME_W}px`}
                label={`review frame after (${pair.sources.after})`}
                lightbox
                imgClass="block w-full h-auto"
              />
              <p class="mt-2 text-sm leading-relaxed text-muted">{pair.after.alt}</p>
            </figure>
          </div>

          <p class="mt-3 text-sm text-muted">Click either photograph to open it full size.</p>

          <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
            <div>
              <h3 class="eyebrow">How it would publish</h3>
              <div class="mt-4" style={`max-width:${sliderW(pair)}px`}>
                <BeforeAfter pair={pair} id={`review-${i}`} width={sliderW(pair)} />
              </div>
            </div>

            <aside class="bg-sand p-6">
              <h3 class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-ink">
                Why it is not live
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{pair.evidence}</p>

              <h3 class="mt-6 font-display text-sm font-semibold uppercase tracking-[0.16em] text-ink">
                What I need from you
              </h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-soft">
                <li>Is this one job at one address?</li>
                <li>Is <code>{pair.sources.after}</code> genuinely the later frame?</li>
                <li>Publish it, or drop it from the set?</li>
              </ul>
            </aside>
          </div>
        </li>
      ))}
    </ol>

    <section class="mt-24 border-t border-line pt-16">
      <p class="eyebrow">Live on the site</p>
      <h2 class="mt-2 text-[var(--text-h2)] font-semibold uppercase text-ink">
        {CONFIRMED_PAIRS.length === 1 ? 'The confirmed pairing' : 'The confirmed pairings'}
      </h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-soft">
        These are on the home page and the featured work page now. Each cleared the
        bar the same way — fixed landmarks visible in both frames, and new work
        following the exact line of what it replaced — rather than on the strength
        of filenames, which are not reliable here.
      </p>

      {CONFIRMED_PAIRS.map((pair, i) => (
        <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div style={`max-width:${sliderW(pair)}px`}>
            <BeforeAfter pair={pair} id={`confirmed-${i}`} width={sliderW(pair)} />
          </div>
          <aside class="bg-sand p-6">
            <code class="text-sm text-muted">
              {pair.sources.before} &rarr; {pair.sources.after}
            </code>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{pair.evidence}</p>
          </aside>
        </div>
      ))}
    </section>

    <p class="mt-16 border-t border-line pt-8 text-sm text-muted">
      {PAIRS.length} pairing{PAIRS.length === 1 ? '' : 's'} total &middot;{' '}
      {CONFIRMED_PAIRS.length} live &middot; {CANDIDATE_PAIRS.length} awaiting a
      verdict. Back to the{' '}
      <a class="text-cpf-red underline" href={withBase('/')}>review build home page</a>.
    </p>
  </div>
</Layout>
