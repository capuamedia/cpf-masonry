---
/**
 * /reviews/ — the dedicated social-proof page.
 *
 * Nothing on this page is written by CPF about CPF. The rating figures are
 * cited from the two listings, and the review text comes from the Elfsight
 * widget, which reads Yelp and Google live. That is the whole point: a new
 * domain with no history has to borrow its credibility from somewhere
 * checkable, and invented testimonials would be both dishonest and, for a
 * licensed contractor, genuinely risky.
 *
 * NO REVIEW COUNTS ON THIS PAGE, deliberately. Owner's call, 2026-09-26: the
 * totals are honest but small, and "34 reviews" undersells a contractor with
 * thirty-five years of work behind him. Five stars on both listings is the
 * claim worth making; the count is not. The page says "an aggregate across
 * Yelp and Google" and leaves the arithmetic alone.
 *
 * This also retired a paragraph explaining that the Yelp total is approximate
 * because Yelp filters some reviews. True, and exactly the kind of thing a
 * prospect never asked and should not have to read. Caveats about how the
 * numbers were sourced belong in NOTES.md, which is where they now live.
 *
 * `reviewCount` is still emitted in the LocalBusiness schema from Layout.astro
 * — schema.org requires a count on an AggregateRating, and it is accurate. It
 * is structured data for search engines, not copy for customers.
 *
 * NO "LEAVE A REVIEW" SECTION HERE, AND IT IS NOT AN OVERSIGHT. The Elfsight
 * widget ships its own write-a-review call to action, which is why you will not
 * find one in this file — it is inside the embed, not the markup. This page
 * used to close with a "worked with us before? call us and we will send you the
 * link" panel, which sat directly under a button that already does the job and
 * asked people to make a phone call to reach it. Removed 2026-09-26.
 *
 * Still true: no canonical Yelp or Google Business Profile URL survived the
 * loss of the old site, so nothing here links out to either listing. Do not
 * guess them — a review link landing on the wrong business is worse than no
 * link — and check whether the widget has already made the question moot before
 * adding any.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { A } from '../lib/assets';
import { BUSINESS, YEARS_IN_BUSINESS, SITE_URL } from '../lib/site';

const description = `CPF Custom Concrete and Masonry is rated five stars on both Yelp and Google. Read what homeowners across the Conejo Valley say about our concrete, masonry and hardscape work.`;

/** Counts are deliberately not surfaced — see the note at the top of the file. */
const LISTINGS = [
  { name: 'Yelp', rating: BUSINESS.ratings.yelp.value },
  { name: 'Google', rating: BUSINESS.ratings.google.value },
];

const STARS = 5;
---

<Layout
  title="Reviews"
  description={description}
  extraSchema={[
    {
      '@type': 'WebPage',
      name: `Reviews of ${BUSINESS.name}`,
      description,
      mainEntity: { '@id': `${SITE_URL}/#business` },
    },
  ]}
>
  <PageHeader
    eyebrow="Reviews"
    title="Rated 5.0 by the people we built for"
    intro={`Five stars on Yelp. Five stars on Google. ${YEARS_IN_BUSINESS} years of concrete and masonry in the Conejo Valley, in the words of the people we built it for.`}
    asset={A.waterGarden}
  />

  <section class="border-b border-line bg-surface py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-8 sm:grid-cols-2">
        {
          LISTINGS.map((l) => (
            <div class="border border-line bg-ground p-8 text-center">
              <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-muted">
                {l.name}
              </p>
              <p class="mt-3 font-display text-6xl font-bold leading-none text-ink">
                {l.rating.toFixed(1)}
              </p>
              <p class="mt-3 text-cpf-yellow" aria-label={`${l.rating} out of ${STARS} stars`}>
                {Array.from({ length: STARS }).map(() => (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="inline-block"
                    aria-hidden="true"
                  >
                    <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z" />
                  </svg>
                ))}
              </p>
            </div>
          ))
        }
      </div>

      <p class="mx-auto mt-10 max-w-2xl text-center text-lg leading-relaxed text-ink-soft">
        An aggregate of our reviews across Yelp and Google, pulled live from both
        listings.
      </p>
    </div>
  </section>

  {/*
    The "CPF Full Reviews" widget, not the compact duo used on the home and
    contact pages. This page exists to carry the whole set, so it gets the
    taller embed and a matching height reservation.
  */}
  <Reviews
    eyebrow="In their words"
    heading="What our customers say"
    intro="Straight from the Yelp and Google listings — not a word of it written by us."
    tinted={false}
    appId="75ef0de3-c2c7-4a3e-97ba-b83dfc658bfd"
    minHeight={900}
  />

  <CtaBand
    heading="Hire the crew they are talking about"
    body={`Family owned and owner supervised since ${BUSINESS.founded} — CA License #${BUSINESS.license}. Tell us what you are building and where, and you will get a straight answer on scope and price.`}
  />
</Layout>
