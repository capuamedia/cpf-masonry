---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import { A } from '../../lib/assets';
import { withBase } from '../../lib/urls';

const services = [
  {
    href: '/custom-concrete/',
    title: 'Custom & Stamped Concrete',
    blurb:
      'Stamped, colored and paver driveways, patios, walkways and commercial flatwork. Finishes chosen to sit with the house, not fight it — and the banding, borders and retaining walls poured as part of the same job.',
    bullets: ['Stamped and colored driveways', 'Paver driveways', 'Aprons and garage transitions', 'Paver walkways and patios', 'Sidewalk banding and borders', 'Commercial concrete and signage'],
    asset: A.stampedDriveway,
  },
  {
    href: '/masonry/',
    title: 'Block, Brick & Natural Stone',
    blurb:
      'Foundations, retaining walls, property-line block walls, brick and natural stone veneer — engineered and built to hold a Conejo Valley slope for the long run.',
    bullets: ['Foundations and footings', 'Segmental and poured retaining walls', 'Property-line block walls', 'Brick walls and paving', 'Natural stone and veneer'],
    asset: A.hillsideBlockRetainingWallConstruction,
  },
  {
    href: '/concrete-countertops/',
    title: 'Concrete Countertops',
    blurb:
      'Cast from scratch since long before they became the new trend — kitchen counters, outdoor bars and fire-feature tops in shapes a stone slab cannot do.',
    bullets: ['Cast kitchen countertops', 'Fiber-optic lit tops', 'Polished and sealed finishes', 'Outdoor barbecue counters', 'Integrated sinks and coolers', 'Fire-feature tops'],
    asset: A.blackConcreteCountertops,
  },
  {
    href: '/stonework/',
    title: 'Custom Stonework',
    blurb:
      'Rubble and ashlar stonemasonry: veneer, garden and retaining walls, walkways, pillars and water features — with design and conceptual drawings if you need them.',
    bullets: ['Stone veneer', 'Garden and retaining walls', 'Stone walkways', 'Pillars and mailbox monuments', 'Water features'],
    asset: A.naturalStoneStepsStackedStoneRetainingWall,
  },
  {
    href: '/grading-and-excavation/',
    title: 'Grading & Excavation',
    blurb:
      'Our own fleet of tractors, excavators and dump trucks — so the site preparation under a wall or a slab is not a separate contractor to coordinate.',
    bullets: ['Site clearance and demolition', 'Footing and foundation excavation', 'Grading and reshaping', 'Spoil handling and haul-off', 'Drainage preparation'],
    asset: A.excavatorAndLoaderStrippingFrontYard,
  },
  {
    href: '/fireplaces-and-barbecues/',
    title: 'Outdoor Kitchens & Fireplaces',
    blurb:
      'Backyard kitchens, fireplaces, fire pits, seating walls and counters, built in stone and brick to work with the pool, the patio and the planting already there.',
    bullets: ['Outdoor kitchens and BBQ surrounds', 'Fireplaces and chimneys', 'Fire pits and seating walls', 'Concrete and stone counters', 'Pergola and patio bases'],
    asset: A.dosVientosOutdoorKitchenTiledCounter,
  },
];

const description =
  'Concrete and masonry services across Newbury Park, Thousand Oaks and the Conejo Valley: stamped concrete driveways, block retaining walls, brick, natural stone, outdoor kitchens and fireplaces.';
---

<Layout
  title="Services"
  description={description}
  extraSchema={services.map((s) => ({
    '@type': 'Service',
    name: s.title,
    serviceType: s.title,
    provider: { '@id': 'https://cpfmasonry.com/#business' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Conejo Valley, California' },
  }))}
>
  <PageHeader
    eyebrow="What we build"
    title="Concrete and masonry services"
    intro="From a single poured countertop to a full property-line retaining wall — the same crew, owner supervised, licensed under C-29 masonry and C-8 concrete."
    asset={A.stoneRetainingWallAndStampedConcreteDriveway}
  />

  {/*
    A card grid, not the alternating image/text list this page used to be.
    That layout gives each service a full screen-height row, which was fine for
    three services and is a seven-screen scroll for seven. This is a hub: people
    arrive to find the one they want and leave. Scanning beats reading here.
  */}
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li class="group flex flex-col border border-line bg-surface transition-colors hover:border-cpf-red">
            <a href={withBase(s.href)} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <Img
                asset={s.asset}
                displayW={500}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                label={`services overview: ${s.title}`}
                imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </a>

            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-xl font-semibold uppercase leading-tight">
                <a href={withBase(s.href)} class="hover:text-cpf-red">{s.title}</a>
              </h2>
              <hr class="rule-red mt-3" />
              <p class="mt-4 leading-relaxed text-ink-soft">{s.blurb}</p>

              <ul class="mt-5 space-y-1.5">
                {s.bullets.map((b) => (
                  <li class="flex gap-2 text-sm text-muted">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-cpf-red" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>

              {/* mt-auto pins the action to the bottom so the row of cards lines
                  up regardless of how much blurb each one carries. */}
              <p class="mt-auto pt-6">
                <a
                  href={withBase(s.href)}
                  class="font-display text-base font-semibold uppercase tracking-wide text-cpf-red group-hover:underline"
                >
                  {s.title} &rarr;
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <CtaBand />
</Layout>
