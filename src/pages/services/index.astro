---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import { A } from '../../lib/assets';
import { withBase } from '../../lib/urls';

const services = [
  {
    href: '/services/concrete/',
    title: 'Custom & Stamped Concrete',
    blurb:
      'Custom designed and poured concrete driveways, pavers, patios, water features and countertops. Stamped and colored finishes chosen to sit with the house, not fight it.',
    bullets: ['Driveways and aprons', 'Stamped and colored flatwork', 'Paver walkways and patios', 'Poured countertops', 'Fountains and water features'],
    asset: A.stampedDriveway,
  },
  {
    href: '/services/masonry/',
    title: 'Block, Brick & Natural Stone',
    blurb:
      'Foundations, retaining walls, property-line block walls, brick and natural stone veneer — engineered and built to hold a Conejo Valley slope for the long run.',
    bullets: ['Foundations and footings', 'Segmental and poured retaining walls', 'Property-line block walls', 'Brick walls and paving', 'Natural stone and veneer'],
    asset: A.dosVientosWall,
  },
  {
    href: '/services/outdoor/',
    title: 'Outdoor Kitchens & Fireplaces',
    blurb:
      'Backyard kitchens, fireplaces, fire pits, seating walls and counters, built in stone and brick to work with the pool, the patio and the planting already there.',
    bullets: ['Outdoor kitchens and BBQ surrounds', 'Fireplaces and chimneys', 'Fire pits and seating walls', 'Concrete and stone counters', 'Pergola and patio bases'],
    asset: A.stoneFireplaceTall,
  },
];

const description =
  'Concrete and masonry services across Newbury Park, Thousand Oaks and the Conejo Valley: stamped concrete driveways, block retaining walls, brick, natural stone, outdoor kitchens and fireplaces.';
---

<Layout
  title="Services"
  description={description}
  extraSchema={services.map((s) => ({
    '@type': 'Service',
    name: s.title,
    serviceType: s.title,
    provider: { '@id': 'https://cpf-masonry.com/#business' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Conejo Valley, California' },
  }))}
>
  <PageHeader
    eyebrow="What we build"
    title="Concrete and masonry services"
    intro="From a single poured countertop to a full property-line retaining wall — the same crew, the same guaranteed completion date, the same insurance cover."
    asset={A.roseFrontage}
  />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <ul class="space-y-16">
      {
        services.map((s, i) => (
          <li class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            <div class={i % 2 ? 'md:order-2' : ''}>
              <a href={withBase(s.href)} class="group block">
                <Img
                  asset={s.asset}
                  displayW={500}
                  sizes="(max-width: 768px) 100vw, 480px"
                  label={`services overview: ${s.title}`}
                  imgClass="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </a>
            </div>
            <div class={i % 2 ? 'md:order-1' : ''}>
              <h2 class="text-[var(--text-h2)] font-semibold uppercase leading-tight">
                <a href={withBase(s.href)} class="hover:text-cpf-red">{s.title}</a>
              </h2>
              <hr class="rule-red mt-4" />
              <p class="mt-4 text-lg leading-relaxed text-ink-soft">{s.blurb}</p>
              <ul class="mt-5 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
                {s.bullets.map((b) => (
                  <li class="flex gap-2 text-muted">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-cpf-red" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
              <p class="mt-6">
                <a
                  href={withBase(s.href)}
                  class="inline-block bg-cpf-red px-5 py-3 font-display text-base font-semibold uppercase tracking-wide text-white hover:bg-cpf-red-dark"
                >
                  {s.title} &rarr;
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <CtaBand />
</Layout>
